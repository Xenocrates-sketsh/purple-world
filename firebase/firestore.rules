rules_version = '2';

// ===========================================================================
// Purple World — Firestore Security Rules
//
// Model: Freelancer MBA-like private academy. Hafsa (teacher, seeded via the
// Admin SDK script) controls ALL academic data. Students only read their own
// slice and create their own chat messages/submissions.
//
// Single source of truth for role: users/{uid}.role (client cannot tamper
// with it — see the users match below). Custom claims remain available as an
// optional defense-in-depth upgrade on Blaze, but rules rely on the doc.
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Shared helpers
    // ------------------------------------------------------------------
    function isAuth() {
      return request.auth != null;
    }

    function isTeacher() {
      return isAuth() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        request.auth.token.role == 'teacher'
      );
    }

    function isStudent() {
      return isAuth() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student' ||
        request.auth.token.role == 'student'
      );
    }

    function myUid() {
      return request.auth.uid;
    }

    // Requires the current user's users/{uid} doc to exist.
    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myStudentId() {
      return getUser().studentId;
    }

    function myGroupId() {
      return getUser().groupId;
    }

    // Teacher-set lockout: a blocked user may not start chats, send messages
    // or touch participant markers. Reads stay open so their own profile and
    // the blocked gate keep working. NOTE: missing fields are an ERROR in
    // rules, so we must guard with `in` before reading .blocked (most
    // existing users docs predate this field and have no blocked key).
    function isBlocked() {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return 'blocked' in user && user.blocked == true;
    }

    // The academy's teacher account, so students know who to message.
    function teacherUid() {
      return get(/databases/$(database)/documents/settings/teacher).data.uid;
    }

    function isParticipant(conversation) {
      return conversation.participantIds != null &&
             conversation.participantIds.hasAny([request.auth.uid]);
    }

    // A student may create ONLY a direct conversation with the teacher:
    // exact participant pair, their own studentId, no group/name/last message.
    function validStudentConversationCreate(newData) {
      return newData.kind == 'direct'
        && newData.participantIds.hasAll([request.auth.uid, teacherUid()])
        && newData.participantIds.size() == 2
        && newData.studentId == myStudentId()
        && newData.teacherId == teacherUid()
        && newData.groupId == null
        && newData.name == null
        && newData.lastMessageAt == null
        && newData.lastMessagePreview == null
        && newData.lastMessageSenderId == null;
    }

    // Restrict an update to an allow-list of fields.
    function onlyFields(newData, oldData, allowed) {
      return newData.diff(oldData).affectedKeys().hasOnly(allowed);
    }

    // Convenience: read a conversation's doc (used by messages/participants).
    function conversationData(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
    }

    // Messenger-style nicknames: a map of participantUid -> label the owner
    // wants to see for that person in this conversation. Keys must be actual
    // participants (same pattern as the message-reactions rule); value
    // constraints (non-empty strings, <= 30 chars) are enforced client-side
    // and by Firestore's own per-document limits.
    function validNicknames(nicknames, conversation) {
      return nicknames == null || (
        nicknames is map
        && nicknames.keys().hasOnly(conversation.participantIds)
      );
    }

    // A message starts clean: sender-only read, no edit/delete/reactions yet.
    function validMessageCreate(newData, conversation) {
      return newData.senderId == request.auth.uid
        && newData.readBy.hasAll([request.auth.uid])
        && newData.readBy.hasOnly(conversation.participantIds)
        && newData.editedAt == null
        && newData.deletedAt == null
        && newData.reactions == null;
    }

    // Updates may only touch readBy / text+editedAt / deletedAt / reactions,
    // and each change is constrained:
    //   - text: only by the sender (marks editedAt)
    //   - deletedAt: only by the sender or a teacher
    //   - reactions: only participants, only the curated emoji set
    //   - readBy: append-only, must include the caller, participants only
    function validMessageUpdate(newData, oldData, conversation) {
      let changed = newData.diff(oldData).affectedKeys();
      return changed.hasOnly(['readBy', 'text', 'editedAt', 'deletedAt', 'reactions'])
        && (!changed.hasAny(['text'])
            || (newData.editedAt != null
                && (request.auth.uid == oldData.senderId || isTeacher())))
        && (!changed.hasAny(['deletedAt'])
            || (newData.deletedAt != null
                && (request.auth.uid == oldData.senderId || isTeacher())))
        && (!changed.hasAny(['reactions'])
            || (newData.reactions != null
                && newData.reactions.keys().hasOnly(conversation.participantIds)
                && newData.reactions.values().hasOnly(
                     ['👍', '❤️', '😂', '😮', '😢', '😡', '👏', '🙏', '🔥', '🎉'])))
        && (!changed.hasAny(['readBy'])
            || (newData.readBy != null
                && newData.readBy.hasAll(oldData.readBy)
                && newData.readBy.hasAny([request.auth.uid])
                && newData.readBy.hasOnly(conversation.participantIds)));
    }

    // ------------------------------------------------------------------
    // users/{uid}
    // - A user reads their own profile (+ teacher reads all).
    // - create: NEVER from the client — no public sign-up. Student accounts
    //   are provisioned by the teacher via the Admin SDK script, which
    //   bypasses rules. Keeping create gated to the teacher here means a
    //   compromised client still can't mint a users doc for an arbitrary
    //   role/uid.
    // - update: self-caretaking fields only; role is immutable.
    //   Teacher may move a student's studentId/groupId (group transfers).
    // ------------------------------------------------------------------
    // ------------------------------------------------------------------
    // settings/{key} — app-wide constants (e.g. the teacher account).
    // Anyone signed in may read them; only the teacher may write.
    // ------------------------------------------------------------------
    match /settings/{key} {
      allow read: if isAuth();
      allow write: if isTeacher();
    }

    match /users/{uid} {
      // Students may also read the teacher's profile (avatar/display name) so
      // the chat UI can show who they're talking to. Only the teacher's doc is
      // exposed this way, and only the fields each rule below already trusts.
      allow read: if isTeacher()
        || (isAuth() && uid == myUid())
        || (isAuth() && uid == teacherUid());
      allow create: if isTeacher();
      allow update: if isAuth() && uid == myUid()
        && request.resource.data.role == resource.data.role
        && onlyFields(request.resource.data, resource.data,
                      ['displayName', 'avatarUrl', 'avatarKey', 'prefs'])
        || (isTeacher()
            && onlyFields(request.resource.data, resource.data,
                          ['groupId', 'studentId', 'displayName', 'blocked']));
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // students/{studentId}
    // - Teacher: full control.
    // - Student: read ONLY their own record (claimed via linkedUid).
    //   The one student write is the one-time claim (linkedUid = self).
    //   Everything else (grades, payments, attendance, group, active) is
    //   teacher-controlled and blocked for students here.
    // ------------------------------------------------------------------
    match /students/{studentId} {
      allow read: if isTeacher() || (isStudent() && resource.data.linkedUid == myUid());
      allow create: if isTeacher();
      allow update: if isTeacher()
        || (isAuth()
            && resource.data.linkedUid == null
            && request.resource.data.linkedUid == myUid()
            && onlyFields(request.resource.data, resource.data, ['linkedUid']))
        // A claimed student may swap their own preset avatar key only.
        || (isStudent()
            && resource.data.linkedUid == myUid()
            && onlyFields(request.resource.data, resource.data, ['avatarKey']));
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // groups/{groupId}
    // - Students may only read the group they belong to.
    // ------------------------------------------------------------------
    match /groups/{groupId} {
      allow read: if isTeacher() || (isStudent() && groupId == myGroupId());
      allow write: if isTeacher();
    }

    // ------------------------------------------------------------------
    // lessons/{lessonId}
    // - Students read only lessons of their group.
    // ------------------------------------------------------------------
    match /lessons/{lessonId} {
      allow read: if isTeacher() || (isStudent() && resource.data.groupId == myGroupId());
      allow write: if isTeacher();

      // attendance/{studentId}
      // - Students read only their own rows (doc id = studentId).
      match /attendance/{attendanceStudentId} {
        allow read: if isTeacher()
          || (isStudent() && attendanceStudentId == myStudentId());
        allow write: if isTeacher();
      }
    }

    // ------------------------------------------------------------------
    // payments/{paymentId}
    // ------------------------------------------------------------------
    match /payments/{paymentId} {
      allow read: if isTeacher() || (isStudent() && resource.data.studentId == myStudentId());
      allow write: if isTeacher();
    }

    // ------------------------------------------------------------------
    // assessments/{assessmentId} and results
    // - Students read the assessment header only when it is about their
    //   group (or is individual, groupId == null); their own result rows.
    // - Scores live in results and are strictly per-student.
    // ------------------------------------------------------------------
    match /assessments/{assessmentId} {
      allow read: if isTeacher()
        || (isStudent() && (resource.data.groupId == null || resource.data.groupId == myGroupId()));
      allow write: if isTeacher();

      match /results/{resultStudentId} {
        allow read: if isTeacher()
          || (isStudent() && resultStudentId == myStudentId());
        allow write: if isTeacher();
      }
    }

    // ------------------------------------------------------------------
    // exercises/{exerciseId} and submissions
    // - Students read only exercises assigned to them (directly or via group).
    // - Students may create/update their OWN submission, and ONLY for an
    //   exercise that is actually assigned to them, and only until... (the
    //   teacher can grade; submissions are otherwise immutable once graded).
    // ------------------------------------------------------------------
    match /exercises/{exerciseId} {
      allow read: if isTeacher()
        || (isStudent() && (
              resource.data.assignedStudentIds.hasAny([myStudentId()])
           || resource.data.assignedGroupIds.hasAny([myGroupId()])
           ));
      allow write: if isTeacher();

      match /submissions/{submissionStudentId} {
        allow read: if isTeacher()
          || (isStudent() && submissionStudentId == myStudentId());

        allow create: if isStudent()
          && submissionStudentId == myStudentId()
          && request.resource.data.studentId == myStudentId()
          && (
            get(/databases/$(database)/documents/exercises/$(exerciseId)).data.assignedStudentIds.hasAny([myStudentId()])
            ||
            get(/databases/$(database)/documents/exercises/$(exerciseId)).data.assignedGroupIds.hasAny([myGroupId()])
          );

        allow update: if isStudent()
          && submissionStudentId == myStudentId()
          && request.resource.data.studentId == myStudentId()
          && onlyFields(request.resource.data, resource.data,
                        ['content', 'attachmentUrl', 'submittedAt', 'studentId']);

        allow delete: if false;
      }
    }

    // ------------------------------------------------------------------
    // announcements/{announcementId}
    // - Students read only announcements whose recipientKeys match their
    //   scope (all / their group / themselves). Server-side filter.
    // ------------------------------------------------------------------
    match /announcements/{announcementId} {
      allow read: if isTeacher()
        || (isStudent() && resource.data.recipientKeys.hasAny(
              ['all', 'group:' + myGroupId(), 'student:' + myStudentId()]));
      allow write: if isTeacher();
    }

    // ------------------------------------------------------------------
    // programUnits + lessons — shared curriculum. Lessons are group-scoped:
    // students only see lessons whose assignedGroupIds is empty (visible to
    // all groups) or contains their own groupId. Teachers see everything.
    // ------------------------------------------------------------------
    match /programUnits/{unitId} {
      allow read: if isAuth();
      allow write: if isTeacher();

      match /lessons/{lessonId} {
        allow read: if isTeacher()
          || (isStudent() && (
                resource.data.assignedGroupIds.size() == 0
             || resource.data.assignedGroupIds.hasAny([myGroupId()])
          ));
        allow write: if isTeacher();
      }
    }

    // ------------------------------------------------------------------
    // conversations/{conversationId}
    // - Teacher: everything except delete.
    // - Student: only conversations they are a participant in.
    //   Students can never see another student's thread.
    // messages:
    //   - create: a participant, senderId MUST equal the caller, the message
    //     starts clean (readBy = sender only, no edit/delete/reactions).
    //   - update: read receipts (append self to readBy), edit own text,
    //     soft-delete own or (teacher) any, add reactions.
    //   - delete: teacher only (hard delete).
    // participants/{uid}: a participant updates their OWN marker
    //   (lastReadAt/typingAt); participants may read all markers of their
    //   own conversation for typing indicators.
    // ------------------------------------------------------------------
    match /conversations/{conversationId} {
      allow read: if isTeacher()
        || (isStudent() && isParticipant(resource.data));
      allow create: if isTeacher()
        || (isStudent() && !isBlocked() && validStudentConversationCreate(request.resource.data));
      allow update: if isTeacher()
        || (isStudent() && isParticipant(resource.data)
              && onlyFields(request.resource.data, resource.data,
                            ['lastMessageAt', 'lastMessagePreview', 'lastMessageSenderId']));
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isTeacher()
          || (isStudent() && isParticipant(conversationData(conversationId)));
        allow create: if isAuth()
          && !isBlocked()
          && validMessageCreate(request.resource.data, conversationData(conversationId))
          && (isTeacher()
              || isParticipant(conversationData(conversationId)));
        allow update: if isAuth()
          && request.resource.data.senderId == resource.data.senderId
          && isParticipant(conversationData(conversationId))
          && validMessageUpdate(request.resource.data, resource.data,
                                conversationData(conversationId));
        allow delete: if isTeacher();
      }

      match /participants/{uid} {
        allow read: if isTeacher()
          || (isAuth() && uid == myUid())
          || isParticipant(conversationData(conversationId));

        // Create: teacher may seed any marker; a participant may self-heal
        // their OWN missing marker. The full new doc is validated (diff-based
        // onlyFields is invalid on create because resource.data is null).
        allow create: if isAuth()
          && !isBlocked()
          && (isTeacher() || (uid == myUid()
                && isParticipant(conversationData(conversationId))))
          && request.resource.data.keys().hasOnly(
               ['uid', 'conversationId', 'lastReadAt', 'typingAt', 'nicknames'])
          && request.resource.data.uid == uid
          && request.resource.data.conversationId == conversationId
          && (!('nicknames' in request.resource.data)
              || validNicknames(request.resource.data.nicknames,
                                conversationData(conversationId)));

        // Update: teacher or owner, allow-listed fields only. Nicknames are
        // validated only when actually present (setTyping/markRead writes
        // carry no nicknames and must not fail).
        allow update: if isAuth()
          && !isBlocked()
          && (isTeacher() || uid == myUid())
          && onlyFields(request.resource.data, resource.data,
                        ['lastReadAt', 'typingAt', 'uid', 'conversationId', 'nicknames'])
          && (!('nicknames' in request.resource.data)
              || validNicknames(request.resource.data.nicknames,
                                conversationData(conversationId)));

        allow delete: if false;
      }
    }

    // ------------------------------------------------------------------
    // notifications/{uid}/items/{notificationId}
    // - Teacher fans out notifications to any user's collection.
    // - A user reads/marks-as-read only their own.
    // ------------------------------------------------------------------
    match /notifications/{uid}/items/{notificationId} {
      allow read: if isTeacher() || (isAuth() && uid == myUid());
      allow create: if isTeacher()
        || (isAuth() && uid == myUid());
      // marking read is the only client-initiated mutation
      allow update: if (isAuth() && uid == myUid()
            && onlyFields(request.resource.data, resource.data, ['read']))
        || isTeacher();
      allow delete: if isTeacher();
    }

    // ------------------------------------------------------------------
    // notes/{studentId}/entries/{entryId} — teacher's private notes.
    // NEVER readable by students.
    // ------------------------------------------------------------------
    match /notes/{studentId}/entries/{entryId} {
      allow read, write: if isTeacher();
    }

    // ------------------------------------------------------------------
    // invites/{code} — the student onboarding flow.
    // - Read is OPEN (any anonymous visitor) while the invite is UNUSED and
    //   not expired. This is acceptable because codes are high-entropy and
    //   enumeration is infeasible; the invite only reveals the student's
    //   email + an opaque student id.
    // - Consumption flips used=false → used=true (any authenticated user,
    //   typically the claiming student right after signup).
    // - Create/update/delete: teacher only.
    // ------------------------------------------------------------------
    match /invites/{code} {
      allow read: if isTeacher()
        || (isAuth()
            && resource.data.used == false
            && (resource.data.expiresAt.toMillis() > request.time.toMillis()));
      allow update: if isTeacher()
        || (isAuth()
            && resource.data.used == false
            && request.resource.data.used == true);
      allow create: if isTeacher();
      allow delete: if isTeacher();
    }

    // ------------------------------------------------------------------
    // arrivals/{arrivalId} — no-password student onboarding.
    // - Anyone can submit a request (create) as long as it is PENDING and
    //   tied to their own uid; a submitter can read only their own request.
    // - The teacher reviews and flips the status to accepted/rejected.
    // ------------------------------------------------------------------
    match /arrivals/{arrivalId} {
      allow read: if isTeacher() || (isAuth() && resource.data.uid == myUid());
      allow create: if isAuth()
        && request.resource.data.uid == myUid()
        && request.resource.data.status == 'pending';
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    // ------------------------------------------------------------------
    // Collection-group access (students viewing their own rows across
    // collections, and users reading their own participant markers).
    // These must be declared as {path=**} rules to cover collection-group
    // queries; the underlying row-level access mirrors the nested rules above.
    // ------------------------------------------------------------------

    match /{path=**}/submissions/{submissionStudentId} {
      allow read: if isTeacher()
        || (isStudent() && submissionStudentId == myStudentId());
    }

    match /{path=**}/results/{resultStudentId} {
      allow read: if isTeacher()
        || (isStudent() && resultStudentId == myStudentId());
    }

    match /{path=**}/attendance/{attendanceStudentId} {
      allow read: if isTeacher()
        || (isStudent() && attendanceStudentId == myStudentId());
    }

    match /{path=**}/participants/{uid} {
      allow read: if isTeacher() || (isAuth() && uid == myUid());
    }
  }
}